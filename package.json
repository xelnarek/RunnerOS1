{
  "name": "runneros-strava-class-pwa",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "typecheck": "tsc -b --pretty false",
    "smoke:api": "node scripts/smoke-api.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:server": "node scripts/verify-server.mjs",
    "verify": "node scripts/test-suite.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "maplibre-gl": "latest",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "vitest": "latest"
  }
}
